[Unit]
Description=autback stale resource cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=autback
Group=autback
SupplementaryGroups=docker
EnvironmentFile=/etc/autback/service.env
ExecStart=/usr/local/bin/autback-server maintain --json
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/autback
