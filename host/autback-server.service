[Unit]
Description=autback shared control plane and scoped data-plane gateways
After=network-online.target docker.service autback-cas.service autback-buildkit.service
Wants=network-online.target
Requires=docker.service autback-cas.service autback-buildkit.service

[Service]
User=autback
Group=autback
SupplementaryGroups=docker
EnvironmentFile=/etc/autback/service.env
ExecStart=/usr/local/bin/autback-server
Restart=always
RestartSec=2
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/autback
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
