[Unit]
Description=outback remote BuildKit
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=-/etc/outback/standards.env
EnvironmentFile=-/etc/outback/swarm.env
ExecStartPre=-/usr/bin/docker rm -f outback-buildkit
ExecStart=/usr/bin/docker run --rm --name outback-buildkit --privileged --network host --memory 3g --pids-limit 4096 -v outback-buildkit-state:/var/lib/buildkit ${OUTBACK_BUILDKIT_IMAGE} --addr tcp://127.0.0.1:1234 --oci-worker-gc=true --oci-worker-gc-keepstorage=30000
ExecStop=/usr/bin/docker stop -t 20 outback-buildkit
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
