[Unit]
Description=outback REAPI and CAS (NativeLink)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=outback
Group=outback
SupplementaryGroups=docker
EnvironmentFile=/etc/outback/standards.env
ExecStart=/usr/local/bin/nativelink /etc/outback/nativelink.json5
Restart=on-failure
RestartSec=3
LimitNOFILE=24576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/outback

[Install]
WantedBy=multi-user.target
