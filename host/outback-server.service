[Unit]
Description=outback shared control plane and scoped data-plane gateways
After=network-online.target docker.service outback-cas.service outback-buildkit.service
Wants=network-online.target
Requires=docker.service outback-cas.service outback-buildkit.service

[Service]
User=outback
Group=outback
SupplementaryGroups=docker
EnvironmentFile=/etc/outback/service.env
ExecStart=/usr/local/bin/outback-server
Restart=always
RestartSec=2
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/outback
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
