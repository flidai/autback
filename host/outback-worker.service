[Unit]
Description=outback Docker worker
After=docker.service outback-server.service
Requires=docker.service outback-server.service

[Service]
User=outback
Group=outback
SupplementaryGroups=docker
EnvironmentFile=/etc/outback/outback.env
Environment=OUTBACK_URL=http://127.0.0.1:8080
Environment=OUTBACK_WORK_ROOT=/var/lib/outback/jobs
Environment=OUTBACK_CACHE_ROOT=/var/lib/outback/cache
Environment=OUTBACK_RUNNER_IMAGE=outback-runner-standard:local
ExecStart=/usr/local/bin/outback-worker
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
